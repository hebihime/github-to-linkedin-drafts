# Copy to .env (never commit .env)

# GitHub: a classic PAT with `repo` (private activity) or public access,
# plus permission to open issues on the drafts repo.
GITHUB_TOKEN=ghp_your_token_here
# Optional dedicated read token. Used instead of GITHUB_TOKEN for Events API.
# GH_PAT=ghp_your_token_here
GITHUB_USERNAME=your-github-login

# Gemini (default). Either name works.
GEMINI_API_KEY=your_gemini_key
# GOOGLE_API_KEY=your_gemini_key

# Other providers (only if llm.provider is not gemini)
# OPENAI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# LinkedIn auto-post (disabled by default — leave unset)
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_PERSON_URN=urn:li:person:...
